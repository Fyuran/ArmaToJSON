{
    "version": 10,
    "include": [
        "CMakePreset_Windows.json",
        "CMakePreset_MinGW.json"
    ],
    "configurePresets": [
        {
            "name": "ninja-multi-vcpkg-static",
            "displayName": "Ninja Multi-Config Linux(Static)",
            "description": "Configure with vcpkg toolchain and generate Ninja project files for all configurations",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "generator": "Ninja Multi-Config",
            "toolchainFile": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "${env:CXX}",
                "BUILD_STATIC": {
                    "type": "BOOL",
                    "value": true
                },
                "PRESET_NAME": "${presetName}"
            },
            "architecture": {
                "value": "x64"
            },
            "toolset": {
                "value": "host=x64"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "ninja-multi-vcpkg",
            "displayName": "Ninja Multi-Config Linux(Dynamic)",
            "description": "Configure with vcpkg toolchain and generate Ninja project files for all configurations",
            "inherits": "ninja-multi-vcpkg-static",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic",
                "BUILD_STATIC": false
            }
        }
    ],
    "buildPresets": [
        {
            "name": "ninja-vcpkg-debug",
            "configurePreset": "ninja-multi-vcpkg",
            "displayName": "Build Linux (Debug)",
            "description": "Build with Ninja/vcpkg (Debug)",
            "configuration": "Debug"
        },
        {
            "name": "ninja-vcpkg-release",
            "configurePreset": "ninja-multi-vcpkg",
            "displayName": "Build Linux (Release)",
            "description": "Build with Ninja/vcpkg (Release)",
            "configuration": "Release"
        },
        {
            "name": "ninja-vcpkg-releasedebinfo",
            "configurePreset": "ninja-multi-vcpkg",
            "displayName": "Build Linux (RelWithDebInfo)",
            "description": "Build with Ninja/vcpkg (RelWithDebInfo)",
            "configuration": "RelWithDebInfo"
        }
    ]
}